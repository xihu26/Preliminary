diff --git a/app/web/line_sync.py b/app/web/line_sync.py
new file mode 100644
index 0000000..573cc3b
--- /dev/null
+++ b/app/web/line_sync.py
@@ -0,0 +1,160 @@
+"""Connect the signed LINE webhook to GinDee's diary and browser sessions."""
+
+import hashlib
+import hmac
+import os
+import secrets
+import time
+from typing import Optional
+from zoneinfo import ZoneInfo
+
+from fastapi import APIRouter, Cookie, Depends, File, Header, HTTPException, Response, UploadFile
+from pydantic import BaseModel, Field, ValidationError
+
+from app import db
+from app.web import api
+
+router = APIRouter(prefix="/api")
+COOKIE = "gindee_line_session"
+LINK_TTL = 300
+SESSION_TTL = 30 * 86400
+DRAFT_TTL = 86400
+
+
+def _digest(token: str) -> str:
+    return hashlib.sha256(token.encode()).hexdigest()
+
+
+def session_user(token: Optional[str]) -> Optional[str]:
+    if not token:
+        return None
+    with db.db() as conn:
+        row = conn.execute(
+            "SELECT user_id FROM line_web_session WHERE token = ? AND expires > ?",
+            (_digest(token), int(time.time())),
+        ).fetchone()
+    return row["user_id"] if row else None
+
+
+def _bot_user(authorization: str = Header(default=""),
+              x_line_user: str = Header(pattern=r"^U[0-9a-fA-F]{32}$")) -> str:
+    secret = os.environ.get("GINDEE_SYNC_SECRET", "")
+    if not secret or not hmac.compare_digest(
+        authorization.encode(), ("Bearer " + secret).encode()
+    ):
+        raise HTTPException(401, "invalid_bot_credentials")
+    return x_line_user
+
+
+@router.post("/line/link")
+def issue_link(user_id: str = Depends(_bot_user)) -> dict:
+    token = secrets.token_urlsafe(32)
+    now = int(time.time())
+    with db.db() as conn:
+        conn.execute("DELETE FROM line_web_link WHERE expires <= ? OR user_id = ?", (now, user_id))
+        conn.execute("INSERT INTO line_web_link VALUES (?, ?, ?)", (_digest(token), user_id, now + LINK_TTL))
+    return {"token": token}
+
+
+class LinkIn(BaseModel):
+    token: str = Field(min_length=43, max_length=43)
+
+
+@router.post("/line/session")
+def sign_in(body: LinkIn, response: Response) -> dict:
+    now = int(time.time())
+    session = secrets.token_urlsafe(32)
+    with db.db() as conn:
+        row = conn.execute(
+            "DELETE FROM line_web_link WHERE token = ? AND expires > ? RETURNING user_id",
+            (_digest(body.token), now),
+        ).fetchone()
+        if not row:
+            raise HTTPException(410, "link_expired")
+        conn.execute("DELETE FROM line_web_session WHERE expires <= ?", (now,))
+        conn.execute("INSERT INTO line_web_session VALUES (?, ?, ?)",
+                     (_digest(session), row["user_id"], now + SESSION_TTL))
+    response.set_cookie(COOKIE, session, max_age=SESSION_TTL, secure=True, httponly=True,
+                        samesite="lax", path="/api")
+    return {"ok": True}
+
+
+@router.delete("/line/session")
+def sign_out(response: Response, gindee_line_session: Optional[str] = Cookie(default=None)) -> dict:
+    if gindee_line_session:
+        with db.db() as conn:
+            conn.execute("DELETE FROM line_web_session WHERE token = ?", (_digest(gindee_line_session),))
+    response.delete_cookie(COOKIE, path="/api", secure=True, httponly=True, samesite="lax")
+    return {"ok": True}
+
+
+def _prepare(user_id: str, message_id: str, estimate: dict) -> dict:
+    if not estimate["is_food"]:
+        return estimate
+    now = api._now()
+    slot = api._guess_slot(now.astimezone(ZoneInfo(api._tz_name(user_id))).hour)
+    try:
+        meal = api.LogIn(slot=slot, items=estimate["items"], eaten_at=now)
+    except ValidationError as exc:
+        raise HTTPException(502, "invalid_meal_estimate") from exc
+    with db.db() as conn:
+        conn.execute(
+            """INSERT INTO line_meal_draft (user_id, message_id, payload, expires)
+               VALUES (?, ?, ?, ?) ON CONFLICT (user_id, message_id) DO NOTHING""",
+            (user_id, message_id, meal.model_dump_json(), int(now.timestamp()) + DRAFT_TTL),
+        )
+        row = conn.execute(
+            "SELECT payload, expires FROM line_meal_draft WHERE user_id = ? AND message_id = ?",
+            (user_id, message_id),
+        ).fetchone()
+    if row["payload"] is None:
+        return {"already_logged": True}
+    if row["expires"] <= int(now.timestamp()):
+        raise HTTPException(410, "draft_expired")
+    return {"is_food": True, "items": api.LogIn.model_validate_json(row["payload"]).model_dump()["items"]}
+
+
+class DescribeIn(api.EstimateIn):
+    message_id: str = Field(pattern=r"^[0-9]{1,32}$")
+
+
+@router.post("/line/estimate")
+async def estimate_text(body: DescribeIn, user_id: str = Depends(_bot_user)) -> dict:
+    return _prepare(user_id, body.message_id, await api.estimate_text(body, user_id))
+
+
+@router.post("/line/scan/{message_id}")
+async def scan_photo(message_id: str, file: UploadFile = File(...),
+                     user_id: str = Depends(_bot_user)) -> dict:
+    if not message_id.isascii() or not message_id.isdigit() or len(message_id) > 32:
+        raise HTTPException(422, "invalid_message_id")
+    return _prepare(user_id, message_id, await api.scan_food(file, user_id))
+
+
+@router.post("/line/confirm/{message_id}")
+def confirm(message_id: str, user_id: str = Depends(_bot_user)) -> dict:
+    target = api._target(user_id)
+    with db.db() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        row = conn.execute(
+            "SELECT payload, expires FROM line_meal_draft WHERE user_id = ? AND message_id = ?",
+            (user_id, message_id),
+        ).fetchone()
+        if not row:
+            raise HTTPException(404, "draft_missing")
+        if row["payload"] is None:
+            return {"already_logged": True}
+        if row["expires"] <= int(time.time()):
+            raise HTTPException(410, "draft_expired")
+        ids = api._insert_meal(conn, api.LogIn.model_validate_json(row["payload"]), user_id, target)
+        conn.execute(
+            "UPDATE line_meal_draft SET payload = NULL WHERE user_id = ? AND message_id = ?",
+            (user_id, message_id),
+        )
+    return {"ids": ids}
+
+
+@router.get("/line/day")
+def today(user_id: str = Depends(_bot_user)) -> dict:
+    day = api.get_day(day=None, user_id=user_id)
+    return {key: day[key] for key in ("date", "entries", "totals")}
