index 0000000..ccf1d12
--- /dev/null
+++ b/tests/test_line_sync_smoke.py
@@ -0,0 +1,51 @@
+from fastapi.testclient import TestClient
+
+from app import config, db
+from app.main import app
+from app.web import line_sync
+
+UID = "U" + "a" * 32
+BOT = {"Authorization": "Bearer test-secret", "X-Line-User": UID}
+MEAL = {
+    "name_en": "Pad Thai", "name_th": "", "kcal": 400, "grams": 200,
+    "protein_g": 12, "carbs_g": 50, "fat_g": 10, "source": "thai_table",
+}
+
+
+def test_cross_platform(tmp_path, monkeypatch):
+    monkeypatch.setattr(config.settings, "db_path", str(tmp_path / "sync.db"))
+    monkeypatch.setenv("GINDEE_SYNC_SECRET", "test-secret")
+    db.init_db()
+    web = TestClient(app, base_url="https://gindee.test")
+    guest = TestClient(app, base_url="https://gindee.test", headers={"X-Gindee-User": UID})
+    bot = TestClient(app, base_url="https://gindee.test", headers=BOT)
+
+    assert guest.post("/api/line/link", headers={"X-Line-User": UID}).status_code == 401
+    token = bot.post("/api/line/link").json()["token"]
+    assert web.post("/api/line/session", json={"token": token}).status_code == 200
+    assert web.post("/api/line/session", json={"token": token}).status_code == 410
+    assert web.get("/api/me").json()["line_connected"]
+    assert not guest.get("/api/me").json()["line_connected"]
+
+    async def estimate(*args):
+        return {"is_food": True, "items": [MEAL]}
